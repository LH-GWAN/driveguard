<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">DriveGuard</string>
    <string name="tagline">차가 멈춘 뒤 응답을 확인하고, 보호자와 구조자를 연결하도록 설계했습니다. 구조를 보장하지 않으며 119를 대신하지 않습니다.</string>
    <string name="notification_title">멈춤 후 응답 확인 켜짐</string>
    <string name="notification_channel">멈춤 후 응답 확인</string>
    <string name="virtual_notice">가상 데이터 · 보호자 전송은 로컬 가상 서버 · 실차 미시험</string>

    <!-- 음성 문구. 응급 안내 문구는 전문가 검토 전 초안이다. -->
    <string name="say_help_guide">가까운 안전한 곳에 바로 세우세요. 필요하면 119에 전화하세요. 가까운 쉼터를 내비에 설정합니다. 취소하려면 괜찮아요 라고 말하세요.</string>
    <string name="say_ask">괜찮으세요? 괜찮으면 괜찮아요 라고 말해 주세요.</string>
    <string name="say_passenger">운전자가 응답하지 않습니다. 차가 멈춰 있으면 기어를 P로 넣어 주세요. 확인하고 119에 신고해 주세요.</string>
    <string name="say_unlock_notice">문 잠금을 해제합니다. 취소하려면 괜찮아요 라고 말하세요.</string>
    <string name="say_open_app">문 잠금을 해제했습니다. 화면에서 앱을 열면 미리 입력한 정보를 볼 수 있습니다.</string>
    <string name="say_cancelled">확인했습니다. 안내를 멈춥니다.</string>
    <string name="say_close_window">창문이 열려 있습니다. 필요하면 닫아 주세요.</string>
    <string name="say_ended">안내를 종료합니다.</string>
    <string name="say_send_failed">보호자에게 보내지 못했습니다.</string>
    <string name="say_no_location">위치를 알 수 없어 목적지를 설정하지 못했습니다.</string>

    <!-- 동의 -->
    <string name="consent_title">시작 전 동의</string>
    <string name="consent_health">건강 정보(병력, 복용약, 응급약 위치)를 차량 안에 암호화해 저장하고, 응답이 없음을 확인한 뒤 차량 화면에 표시하는 데 동의합니다.</string>
    <string name="consent_location">응답 확인에 답이 없거나 도움을 요청했을 때 등록한 보호자에게 위치와 정차 시각을 보내는 데 동의합니다. 병력은 보내지 않습니다.</string>
    <string name="consent_guardian">등록할 보호자에게 이 연락을 받는다는 동의를 받았습니다.</string>
    <string name="consent_next">동의하고 계속</string>

